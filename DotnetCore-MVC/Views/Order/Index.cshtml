@model List<DotnetCore_MVC.Models.OrderVM>


<div>
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>OrderId</th>
                <th>OrderRef</th>
                <th>Customer</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.OrderId</td>
                    <td>@order.OrderRef</td>
                    <td>@order.Customer!.CustomerName</td>
                </tr>
            }
        </tbody>
    </table>
</div>


   
         
       
        